name: Add new issues to the project board
# OPTIONAL. Sigma's own loop already boards every `sdlc:goal`-labelled issue for free, with no
# PAT and no repo secret (`_sync_backlog` in skills/agrim-loop/scripts/sources.py, run on every
# board-touching loop tick). This workflow only buys two things beyond that: same-tick immediacy
# (an issue lands on the board instantly on creation, rather than at the loop's next tick) and
# ANY issue, not just goal-labelled ones. Set the repo variable SDLC_PROJECT_URL and the secret
# ADD_TO_PROJECT_PAT (a PAT with project write scope) only if you want that; until then this is a
# no-op — nothing fails, and nothing is missing from the board either.
on:
  issues:
    types: [opened, reopened]
jobs:
  add-to-project:
    runs-on: ubuntu-latest
    if: ${{ vars.SDLC_PROJECT_URL != '' }}
    steps:
      - uses: actions/add-to-project@v1.0.2
        with:
          project-url: ${{ vars.SDLC_PROJECT_URL }}
          github-token: ${{ secrets.ADD_TO_PROJECT_PAT }}
