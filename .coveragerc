# Test-only coverage configuration (issue #194). Read by `python -m coverage`, never by shipped code,
# and NOT run by CI (see docs/launch/coverage.md: a Linux trial doubled the leg and tripped a timing test).
# The product is mostly scripts run as subprocesses, so `patch = subprocess` makes each child write its
# own data file; `combine` merges them. Needs coverage.py 7.10 or newer. No minimum is configured: nothing
# here is enforced, and the README says so.
[run]
source = skills, hooks
parallel = True
patch = subprocess
data_file = .coverage
